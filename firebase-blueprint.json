        "itemCount": { "type": "integer" },
        "status": { "type": "string", "enum": ["verified", "restored"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "label", "scope", "encryptedSnapshot", "iv", "salt", "checksum", "itemCount", "status", "createdAt", "updatedAt"]
    }
  },
